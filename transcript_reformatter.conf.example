[openai]
# Your OpenAI API key (required)
api_key = sk-your-api-key-here

# Model to use (default: gpt-4o)
# Options: gpt-4o, gpt-4o-mini, o1-preview, o1-mini, gpt-4-turbo, etc.
model = gpt-4.1

# Maximum tokens per response (default: 16000)
# Increase for longer responses, decrease to save costs
max_tokens = 16000

# Temperature for response generation (default: 0.3)
# Lower = more deterministic, Higher = more creative
# Range: 0.0 to 2.0
temperature = 0.1

# Maximum number of continuation requests (default: 10)
# Prevents infinite loops if the model keeps getting cut off
max_continuations = 10

[pipeline]
# Settings for podcast_transcribe.py (the full pipeline). All optional.
# The [openai] api_key above is also used for speaker identification.

# Where resolve_transcribe.py lives (default: ~/dev/resolve_transcribe)
resolve_transcribe_dir = ~/dev/resolve_transcribe

# Save <episode>.resolve.txt and <episode>.speakers.json next to the audio file (default: true)
sidecars = true

# Model used to identify unlabeled speakers; must support web search in the
# OpenAI Responses API (default: speaker_id.DEFAULT_MODEL)
# speaker_id_model =

# Confidence (0-1) needed to auto-accept a suggested name with --yes (default: 0.8)
min_confidence = 0.8
